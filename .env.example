# ---- required ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-@BotFather
# Comma-separated Telegram user IDs allowed to use the bot. Get yours from @userinfobot.
ALLOWED_USER_IDS=123456789

# ---- Solana data (pick at least one) ----
# Helius free tier: https://helius.dev  -> gives RPC + enhanced parsed transactions
HELIUS_API_KEY=
# Solscan Pro (free tier available): https://pro-api.solscan.io -> fastest "earliest buyers" lookup
SOLSCAN_API_KEY=
# Any Solana RPC URL. Leave blank to use Helius (if key set) or public mainnet RPC.
SOLANA_RPC_URL=

# ---- EVM data ----
# One Etherscan V2 key covers ETH, Base, BSC, Arbitrum, Polygon... https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ---- tuning (all optional, these are the defaults) ----
EARLY_BUYER_COUNT=20
ACTIVE_WINDOW_DAYS=30
RECENT_BUY_WINDOW_DAYS=30
OVERLAP_MIN_WALLETS=3
SCORE_BUY_THRESHOLD=9.0

# Exit detection: a position shrinking by this much is a trim...
TRIM_ALERT_PCT=15
# ...and one that falls below this share of its peak counts as fully closed.
EXIT_DUST_PCT=5

# Your account size in USD, used to scale a wallet conviction to your own size.
# Can also be set per chat at runtime with /bankroll.
BANKROLL_USD=0
# Cap on how many of a wallet holdings get priced, to bound API cost.
MAX_PRICED_HOLDINGS=120
BOT_MIN_MEDIAN_GAP_SEC=3
BOT_MAX_TX_PER_DAY=250
WATCHER_INTERVAL_MIN=10
DB_PATH=memehunter.db

# ---- automatic schedules ----
# Auto-scan runs steps 5-7 on a timer and reports only what changed.
AUTOSCAN_INTERVAL_HOURS=6
AUTOSCAN_MIN_SCORE=7.0
# Auto-harvest mines one queued coin per cycle for early buyers.
AUTOHARVEST_INTERVAL_HOURS=12
AUTOHARVEST_MAX_WALLETS=10

# ---- leaderboard ----
# How often open alerts are re-priced, and for how long each one is followed.
OUTCOME_CHECK_MIN=20
OUTCOME_TRACK_HOURS=72
# The multiple a call must reach to count as a hit.
OUTCOME_WIN_MULTIPLE=1.5
# Small samples are shrunk toward this base rate, so a 1-for-1 wallet cannot
# outrank a 12-for-20 one. Higher weight = more evidence needed to rank highly.
LEADERBOARD_PRIOR_RATE=0.25
LEADERBOARD_PRIOR_WEIGHT=4

# ---- multi-chain tracking ----
# Watch an EVM wallet on every EVM chain, not just the one you added it on.
MULTICHAIN=1
# Narrow it if you like, e.g. base,arc,robinhood. Blank means every EVM chain.
MULTICHAIN_CHAINS=
# Chains with no wallet history are parked after this many consecutive empty
# reads (>1, because a failed API call also looks empty) and retried this often.
MULTICHAIN_DORMANT_AFTER=3
MULTICHAIN_REPROBE_HOURS=12
MULTICHAIN_PROBES_PER_CYCLE=12
