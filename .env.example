# ---- required ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-@BotFather
# Comma-separated Telegram user IDs allowed to use the bot. Get yours from @userinfobot.
ALLOWED_USER_IDS=123456789

# ---- Solana data (pick at least one) ----
# Helius free tier: https://helius.dev  -> gives RPC + enhanced parsed transactions
HELIUS_API_KEY=
# Solscan Pro (free tier available): https://pro-api.solscan.io -> fastest "earliest buyers" lookup
SOLSCAN_API_KEY=
# Any Solana RPC URL. Leave blank to use Helius (if key set) or public mainnet RPC.
SOLANA_RPC_URL=

# ---- EVM data ----
# One Etherscan V2 key covers ETH, Base, BSC, Arbitrum, Polygon... https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ---- tuning (all optional, these are the defaults) ----
EARLY_BUYER_COUNT=20
ACTIVE_WINDOW_DAYS=30
RECENT_BUY_WINDOW_DAYS=30
OVERLAP_MIN_WALLETS=3
SCORE_BUY_THRESHOLD=9.0

# Exit detection: a position shrinking by this much is a trim...
TRIM_ALERT_PCT=15
# ...and one that falls below this share of its peak counts as fully closed.
EXIT_DUST_PCT=5

# Your account size in USD, used to scale a wallet conviction to your own size.
# Can also be set per chat at runtime with /bankroll.
BANKROLL_USD=0
# Cap on how many of a wallet holdings get priced, to bound API cost.
MAX_PRICED_HOLDINGS=120
BOT_MIN_MEDIAN_GAP_SEC=3
BOT_MAX_TX_PER_DAY=250
WATCHER_INTERVAL_MIN=10
DB_PATH=memehunter.db
