# ---- required ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-@BotFather
# Comma-separated Telegram user IDs allowed to use the bot. Get yours from @userinfobot.
ALLOWED_USER_IDS=123456789

# ---- Solana data ----
# Helius free tier: https://helius.dev -> a coin's first buyers in one call (any
# size), parsed swap history, and a private RPC. This is the key that matters.
HELIUS_API_KEY=
# Solscan Pro: https://pro-api.solscan.io. The Pro API needs a PAID plan; a
# free-plan key is answered with 401 "Please upgrade your api key level".
SOLSCAN_API_KEY=
# Any Solana RPC URL. Leave blank to use Helius (if key set) or public mainnet RPC.
SOLANA_RPC_URL=

# ---- EVM data ----
# Etherscan V2: https://etherscan.io/apis. The FREE plan covers Ethereum, Arbitrum
# and Polygon only. Base and Avalanche work without it through keyless public
# explorers (Blockscout, Routescan); BSC, Robinhood Chain and Arc need a paid plan.
ETHERSCAN_API_KEY=
# Optional. Base works with no key; a free key from https://dev.blockscout.com
# only raises Blockscout's rate limits.
BLOCKSCOUT_API_KEY=

# ---- tuning (all optional, these are the defaults) ----
EARLY_BUYER_COUNT=20
ACTIVE_WINDOW_DAYS=30
RECENT_BUY_WINDOW_DAYS=30
OVERLAP_MIN_WALLETS=3
SCORE_BUY_THRESHOLD=9.0

# Exit detection: a position shrinking by this much is a trim...
TRIM_ALERT_PCT=15
# ...and one that falls below this share of its peak counts as fully closed.
EXIT_DUST_PCT=5

# Your account size in USD, used to scale a wallet conviction to your own size.
# Can also be set per chat at runtime with /bankroll.
BANKROLL_USD=0
# Cap on how many of a wallet holdings get priced, to bound API cost.
MAX_PRICED_HOLDINGS=120
BOT_MIN_MEDIAN_GAP_SEC=3
BOT_MAX_TX_PER_DAY=250
WATCHER_INTERVAL_MIN=10
DB_PATH=memehunter.db

# ---- automatic schedules ----
# Auto-scan runs steps 5-7 on a timer and reports only what changed.
AUTOSCAN_INTERVAL_HOURS=6
AUTOSCAN_MIN_SCORE=7.0
# Auto-harvest mines one queued coin per cycle for early buyers.
AUTOHARVEST_INTERVAL_HOURS=12
AUTOHARVEST_MAX_WALLETS=10

# ---- leaderboard ----
# How often open alerts are re-priced, and for how long each one is followed.
OUTCOME_CHECK_MIN=20
OUTCOME_TRACK_HOURS=72
# The multiple a call must reach to count as a hit.
OUTCOME_WIN_MULTIPLE=1.5
# Small samples are shrunk toward this base rate, so a 1-for-1 wallet cannot
# outrank a 12-for-20 one. Higher weight = more evidence needed to rank highly.
LEADERBOARD_PRIOR_RATE=0.25
LEADERBOARD_PRIOR_WEIGHT=4

# ---- multi-chain tracking ----
# Watch an EVM wallet on every EVM chain, not just the one you added it on.
MULTICHAIN=1
# Narrow it if you like, e.g. base,arc,robinhood. Blank means every EVM chain.
MULTICHAIN_CHAINS=
# Chains with no wallet history are parked after this many consecutive empty
# reads (>1, because a failed API call also looks empty) and retried this often.
MULTICHAIN_DORMANT_AFTER=3
MULTICHAIN_REPROBE_HOURS=12
MULTICHAIN_PROBES_PER_CYCLE=12

# How many 1000-signature pages to walk back when hunting a token's first
# buyers with neither Helius nor Solscan. Blank/0 = automatic: 30 on the public
# RPC, 200 on a private one.
RPC_MAX_PAGES=
# Solscan free plan is 60 requests per minute. Raise only if you upgrade.
SOLSCAN_RPM=60

# ---- top traders ----
# The wallets that put the least in and took the most out. /traders ranks them,
# and /harvest tracks them alongside the early buyers.
TRADERS_COUNT=5
HARVEST_TRADERS=1
# Ignore entries below this, or a wallet that risked a fraction of a cent shows
# a five-figure multiple and crowds out every real trade.
TRADER_MIN_SPEND_USD=1
# Solana: pages of 100 transactions read from each end of the coin's history.
TRADER_SCAN_PAGES=10
# EVM: how many early buyers to price, and how many pages of each listing to
# read per wallet. Every call is a second of waiting, so these bound it.
TRADER_COHORT=15
TRADER_PAGES=2

# ---- name resolution ----
# Some networks answer api.telegram.org with an address that is not Telegram's,
# and the bot then dies at startup with "All connection attempts failed". With
# this on it resolves the names below over HTTPS, which cannot be forged, instead
# of trusting the network's DNS server. Plain DNS is not enough: forged replies
# race the real ones on port 53 no matter which server you ask.
DNS_FIX=1
# Names to resolve over HTTPS. Comma separated. Add any other host your network
# answers wrongly.
DNS_OVERRIDE_HOSTS=api.telegram.org
# DNS-over-HTTPS endpoints, tried in order. Addressed by IP on purpose: a
# resolver whose own name needs resolving is no use when resolution is broken.
DNS_RESOLVERS=https://8.8.8.8/resolve,https://8.8.4.4/resolve,https://1.0.0.1/dns-query,https://dns.google/resolve

# ---- self-backup (for hosts with no persistent disk) ----
# Only needed on a host with no persistent disk. Off by default; /backup and
# /restore still work by hand. Set to 1 when deploying to Koyeb/Back4App etc.
BACKUP_ENABLED=0
BACKUP_INTERVAL_HOURS=6
# Defaults to the first ALLOWED_USER_IDS entry. Set to use a different chat.
BACKUP_CHAT_ID=
# 0 = never restore automatically; use /restore by hand instead.
BACKUP_AUTO_RESTORE=1

# Seconds before a Telegram call gives up. Raise on a slow or lossy link; a
# long scan holds the connection open and the library default is very tight.
TELEGRAM_TIMEOUT=30
